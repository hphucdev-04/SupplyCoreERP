<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RxLogistics</title>

    <!-- Bootstrap CSS -->
    <link href="~/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="~/libs/@@fortawesome/fontawesome-free/css/all.min.css" rel="stylesheet" />

    <!-- ABP Styles -->
    <abp-style-bundle />

    <!-- Custom Login CSS -->
    <link rel="stylesheet" href="~/css/login-custom.css" />

    <!-- Additional Styles Section -->
    @await RenderSectionAsync("styles", required: false)

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f5f5f5;
        }

        body {
            overflow-x: hidden;
        }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>

    <!-- Bootstrap JS -->
    <script src="~/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- ABP Scripts -->
    <abp-script-bundle />

    <!-- Render Scripts Section -->
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
@using System.Globalization
