root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.csproj]
indent_size = 2

[*.{cs,vb}]
#### Core Formatting Rules ####
dotnet_sort_system_directives_first = true:warning
dotnet_separate_import_directive_groups = false:warning

#### Code Style Rules ####

# Use 'var' preferences (Ưu tiên kiểu tường minh, KHÔNG dùng var)
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_strongly_typed = false:warning
csharp_style_var_elsewhere = false:warning

# Make field readonly (Thêm readonly cho field)
dotnet_style_readonly_field = true:warning

# Namespace preferences (Sử dụng File-scoped namespace: namespace MyNamespace;)
csharp_style_namespace_declarations = file_scoped:warning

# New() preferences (Sử dụng implicit new: var x = new();)
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

# Using statement preferences (Sử dụng using đơn giản)
csharp_prefer_simple_using_statement = true:warning

# Default() preferences (Sử dụng default thay vì default(T))
csharp_prefer_simple_default_expression = true:warning

# Braces preferences (Ngoặc nhọn)
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none

# Unnecessary code (Xóa using thừa, v.v.)
dotnet_remove_unnecessary_suppressions = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
